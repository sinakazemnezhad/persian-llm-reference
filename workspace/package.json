{
  "name": "persian-llm-reference",
  "version": "0.10.3",
  "private": true,
  "type": "module",
  "description": "Global open atlas of Persian (Farsi) language models",
  "scripts": {
    "validate": "node scripts/validate-manifest.mjs",
    "build": "node scripts/build-static.mjs",
    "prebuild": "node scripts/validate-manifest.mjs && node scripts/validate-schema.mjs",
    "prestart": "node scripts/build-static.mjs",
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "sync:python": "node scripts/sync-python-manifest.mjs",
    "e2e": "node scripts/e2e-local.mjs",
    "verify:local": "npm run build && node scripts/validate-links.mjs && node scripts/e2e-local.mjs",
    "validate:links": "node scripts/validate-links.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
